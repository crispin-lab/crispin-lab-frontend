# 백엔드 API base URL (BFF 가 호출). NEXT_PUBLIC_ prefix 없음 — 서버 전용.
BACKEND_URL=

# 자기 자신의 public URL. redirect, OG meta 등에서 사용.
NEXT_PUBLIC_APP_URL=

# `pnpm api:gen` 이 OpenAPI spec 을 찾을 backend 워크트리 root.
# 기본값은 `../crispin-lab-backend` (sibling layout). worktree 사용 시 절대 경로로 지정 권장.
# 셸 rc 또는 worktree 별 환경 변수에 설정해 두면 매번 지정 안 해도 된다.
# LAB_BACKEND_PATH=
